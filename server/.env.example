# Server Environment Configuration
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, <cluster-host>, and <database-name> with your actual MongoDB Atlas credentials
# Get your connection string from: https://cloud.mongodb.com → Connect → Drivers → Node.js
# jeeldonga18_db_user AuRqaOBqhvh3Zkeh
DATABASE_URL="mongodb+srv://jeeldonga18_db_user:[EMAIL_ADDRESS]/jeeldonga18_db?retryWrites=true&w=majority&appName=jeeldonga18_db_cluster"

JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"
