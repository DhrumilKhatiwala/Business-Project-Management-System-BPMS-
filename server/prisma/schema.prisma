generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Module 1: Accounts & Access ─────────────────────────

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName  String
  email     String   @unique
  password  String
  role      String   // ADMIN, BUSINESS_OWNER, WORKER, CLIENT
  phone     String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  worker          Worker?
  createdProjects Project[]     @relation("ProjectCreator")
  clientProjects  Project[]     @relation("ClientProjects")
  stockUpdates    StockUpdate[]
  createdInvoices Invoice[]     @relation("InvoiceCreator")
  clientInvoices  Invoice[]     @relation("ClientInvoices")
  recordedPayments Payment[]    @relation("PaymentRecorder")
  createdExpenses Expense[]     @relation("ExpenseCreator")

  @@index([role])
  @@index([status])
}

// ─── Module 2: Workforce & Projects ──────────────────────

model Worker {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  userId   String  @unique @db.ObjectId
  position String?
  skills   String? @default("[]") // JSON string of skills array
  status   String  @default("ACTIVE") // ACTIVE, INACTIVE

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments ProjectAssignment[]
  tasks       Task[]

  @@index([status])
}

model Project {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  status      String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, ON_HOLD, COMPLETED
  startDate   DateTime?
  endDate     DateTime?
  progress    Int       @default(0) // 0-100
  createdById String    @db.ObjectId
  clientId    String?   @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy   User                @relation("ProjectCreator", fields: [createdById], references: [id])
  client      User?               @relation("ClientProjects", fields: [clientId], references: [id])
  tasks       Task[]
  milestones  Milestone[]
  assignments ProjectAssignment[]
  materials   ProjectMaterial[]
  invoices    Invoice[]
  expenses    Expense[]

  @@index([status])
  @@index([createdById])
  @@index([clientId])
}

model Task {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  priority     String    @default("MEDIUM")  // LOW, MEDIUM, HIGH, URGENT
  dueDate      DateTime?
  projectId    String    @db.ObjectId
  assignedToId String?   @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo Worker? @relation(fields: [assignedToId], references: [id])

  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
}

model Milestone {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  projectId   String    @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model ProjectAssignment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId  String   @db.ObjectId
  workerId   String   @db.ObjectId
  assignedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([projectId, workerId])
  @@index([projectId])
  @@index([workerId])
}

// ─── Module 3: Inventory & Materials ─────────────────────

model Material {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  category      String?
  unit          String   @default("pcs")
  quantity      Int      @default(0)
  minStockLevel Int      @default(10)
  costPerUnit   Float    @default(0)
  supplier      String?
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockUpdates       StockUpdate[]
  lowStockAlerts     LowStockAlert[]
  projectAllocations ProjectMaterial[]

  @@index([name])
  @@index([category])
  @@index([status])
}

model StockUpdate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  materialId  String   @db.ObjectId
  type        String   // ADD, DEDUCT
  quantity    Int
  previousQty Int
  newQty      Int
  note        String?
  createdAt   DateTime @default(now())
  createdById String   @db.ObjectId

  material  Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([materialId])
  @@index([createdById])
}

model LowStockAlert {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  materialId      String    @db.ObjectId
  currentQuantity Int
  minStockLevel   Int
  status          String    @default("ACTIVE") // ACTIVE, RESOLVED
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([status])
}

model ProjectMaterial {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  materialId  String   @db.ObjectId
  quantity    Int
  allocatedAt DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([projectId, materialId])
  @@index([projectId])
  @@index([materialId])
}

// ─── Module 5: Invoices, Payments & Financials ───────────

model Invoice {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String       @unique
  projectId     String       @db.ObjectId
  clientId      String?      @db.ObjectId
  amount        Float        @default(0)
  paidAmount    Float        @default(0)
  dueDate       DateTime?
  issuedDate    DateTime     @default(now())
  status        String       @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  notes         String?
  items         String?      @default("[]") // JSON string of [{ description, quantity, unitPrice, total }]
  createdById   String       @db.ObjectId
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client        User?        @relation("ClientInvoices", fields: [clientId], references: [id])
  createdBy     User         @relation("InvoiceCreator", fields: [createdById], references: [id])
  payments      Payment[]

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([createdById])
}

model Payment {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId     String       @db.ObjectId
  amount        Float
  paymentDate   DateTime     @default(now())
  paymentMethod String       @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, CHEQUE, ONLINE
  reference     String?
  notes         String?
  recordedById  String       @db.ObjectId
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy    User         @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([recordedById])
}

model Expense {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  category    String    // MATERIALS, LABOUR, EQUIPMENT, SUBCONTRACTOR, MISC
  amount      Float
  date        DateTime  @default(now())
  projectId   String?   @db.ObjectId
  notes       String?
  createdById String    @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy   User      @relation("ExpenseCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([category])
  @@index([createdById])
}
